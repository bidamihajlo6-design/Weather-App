@page
@model IndexModel
@{
    ViewData["Title"] = "WeatherApp";
}

<div class="text-center">
    <h1>WeatherApp</h1>
    <p>Програма для перегляду погоди</p>

    <form method="post">
        <input type="text" name="city" placeholder="Введіть місто" />

        <button type="submit">Пошук</button>
    </form>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p> @Model.ErrorMessage</p>
    }
    @if (!string.IsNullOrEmpty(Model.Weather.City))
    {<h2>Місто: @Model.Weather.City</h2>

    <h3>Опис: @Model.Weather.Description</h3>

    <p>Температура: @Model.Weather.Temperature °C</p>

    <p>Відчувається як: @Model.Weather.FeelsLike °C</p>

    <p>Вологість: @Model.Weather.Humidity %</p>

    <p>Тиск: @Model.Weather.Pressure hPa</p>

    <p>Вітер: @Model.Weather.WindSpeed м/с</p>

    <p>Напрямок: @WeatherApp.Models.WeatherHelper.GetWindDirection(Model.Weather.WindDirection)</p>

    <p>Хмарність: @Model.Weather.Cloudiness %</p>

    <p>Видимість: @Model.Weather.Visibility км</p>
    }
</div>
