@page
@model IndexModel
@{
    ViewData["Title"] = "WeatherApp";
}

<div class="text-center">
    <h1 class="app-title">WeatherApp</h1>
    <p class="app-subtittle">Погода у твоєму місці</p>

    <form method="post" class="search-form">
        <input type="text" name="city" placeholder="Введіть місто" class="city-input" />

        <button type="submit" class="search-button">Пошук</button>
    </form>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="error-message"> @Model.ErrorMessage</p>
    }
    @if (!string.IsNullOrEmpty(Model.Weather.City)) {
<div class="weather-card">
        <h2 class="weather-city">@Model.Weather.City</h2>

        <h3 class="weather-description">@Model.Weather.Description</h3>
    <div class="weather-main">  
        @if (!string.IsNullOrEmpty(Model.Weather.Icon))
            {
                <img src="https://openweathermap.org/img/wn/@(Model.Weather.Icon)@@2x.png"
                    alt="@Model.Weather.Description"
                    class="weather-icon" />
        
            }
                <p class="weather-temperature">@Model.Weather.Temperature °C</p>
    </div>
    <div class="weather-details">

        <p class="weather-detail">Відчувається як: @Model.Weather.FeelsLike °C</p>

        <p class="weather-detail">Вологість: @Model.Weather.Humidity %</p>

        <p class="weather-detail">Тиск: @Model.Weather.Pressure hPa</p>

        <p class="weather-detail">Вітер: @Model.Weather.WindSpeed м/с</p>

        <p class="weather-detail">Напрямок: @WeatherApp.Models.WeatherHelper.GetWindDirection(Model.Weather.WindDirection)</p>

        <p class="weather-detail">Хмарність: @Model.Weather.Cloudiness %</p>

        <p class="weather-detail">Видимість: @Model.Weather.Visibility км</p>
        </div>
    </div>
}
