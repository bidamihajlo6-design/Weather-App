@page
@model IndexModel
@{
    ViewData["Title"] = "WeatherApp";
}

<div class="text-center">
    <h1>WeatherApp</h1>
    <p>Програма для перегляду погоди</p>

    <form method="post">
        <input type="text" name="city" placeholder="Введіть місто" />

        <button type="submit">Пошук</button>
    </form>
    @if (!string.IsNullOrEmpty(Model.Weather.City))
    {
        <h2>Місто: @Model.Weather.City</h2>
        <p>Температура: @Model.Weather.Temperature °C</p>
        <p>Вологість: @Model.Weather.Humidity %</p>
    }
</div>
